# Alert on any Modbus WRITE that does not come from the HMI (172.28.0.20)
alert modbus !172.28.0.20 any -> 172.28.0.10 502 (msg:"OT LAB Unauthorized Modbus write to PLC"; modbus: access write; sid:1000001; rev:1;)
# Alert on any Modbus request from an unknown host
alert modbus ![172.28.0.20,172.28.0.10] any -> 172.28.0.10 502 (msg:"OT LAB Modbus request from unknown host"; sid:1000002; rev:1;)
